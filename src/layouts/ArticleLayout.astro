---
import BaseLayout from './BaseLayout.astro';
import { relatedArticles } from '../data/articles.js';
import { MAILLAGE } from '../data/maillage.js';
import { RETENIR } from '../data/retenir.js';
import { MODULE1_URL } from '../data/site.js';

const RDV = 'https://app.iclosed.io/e/emiredschool/immoseille';

const {
  title,
  description,
  eyebrow = 'Le métier',
  h1,
  lead,
  image,
  imageAlt = '',
  breadcrumb = [],
  updated = '9 août 2026',
  datePublished = '2026-07-30',
  dateModified = '2026-08-09',
  reading = '7 min',
  faq = [],
  author = {
    name: 'Nath',
    role: 'Marchand de biens en activité',
    bio: "Marchand de biens en activité depuis 3 ans, spécialisé dans la division de gros ensembles immobiliers. Il partage ici les méthodes concrètes du métier, du montage d'opération jusqu'à la revente.",
  },
  ctaTitle = 'Vous voulez vous lancer avec méthode ?',
  ctaText = "Plutôt que de rester seul face aux questions, échangeons sur votre projet. 20 minutes, sans engagement.",
} = Astro.props;

const site = Astro.site ?? new URL('https://immoseille.fr');
const canonical = new URL(Astro.url.pathname, site).href;

const curSlug = Astro.url.pathname.replace(/^\/|\/$/g, '');
const related = relatedArticles(curSlug, 5);
const retenirItems = RETENIR[curSlug] || [];

const breadcrumbLd = breadcrumb.length ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumb.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.label,
    ...(b.href ? { item: new URL(b.href, site).href } : {}),
  })),
} : null;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: h1,
  description,
  inLanguage: 'fr-FR',
  datePublished,
  dateModified,
  mainEntityOfPage: canonical,
  ...(image ? { image: new URL(image, site).href } : {}),
  author: { '@type': 'Person', name: author.name, jobTitle: author.role },
  publisher: { '@type': 'Organization', name: "Imm'oseille", url: site.href },
};

const faqLd = faq.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.r },
  })),
} : null;

const initial = (author.name || 'I').trim().charAt(0).toUpperCase();
---

<BaseLayout title={title} description={description}>
  <article class="art">
    <div class="art-container">
      {breadcrumb.length > 0 && (
        <nav class="art-breadcrumb" aria-label="Fil d'Ariane">
          <ol>
            {breadcrumb.map((b, i) => (
              <li>
                {b.href ? <a href={b.href}>{b.label}</a> : <span aria-current="page">{b.label}</span>}
                {i < breadcrumb.length - 1 && <span class="bc-sep" aria-hidden="true">›</span>}
              </li>
            ))}
          </ol>
        </nav>
      )}

      <header class="art-hero2">
        <div class="art-hero2-text">
          <p class="eyebrow">{eyebrow}</p>
          <h1>{h1}</h1>
          <hr class="art-rule" />
          <div class="art-byline">
            <span class="art-ava" aria-hidden="true">{initial}</span>
            <span class="art-byline-txt">
              Écrit par <strong>{author.name}</strong>, {author.role}
              <span class="art-byline-meta">Mis à jour le {updated} · Lecture {reading}</span>
            </span>
          </div>
          {lead && <p class="art-lead">{lead}</p>}
        </div>

        {image && (
          <figure class="art-hero2-fig">
            <img src={image} alt={imageAlt} width="640" height="480" />
          </figure>
        )}
      </header>

      <div class="art-layout">
        <div class="art-body">
          <slot />

          {retenirItems.length > 0 && (
            <aside class="retenir" aria-label="À retenir">
              <p class="retenir-h">À retenir</p>
              <ul>
                {retenirItems.map((x) => <li>{x}</li>)}
              </ul>
            </aside>
          )}

          {faq.length > 0 && (
            <>
              <h2 id="faq">Questions fréquentes</h2>
              <div class="faq">
                {faq.map((f) => (
                  <details class="faq-item">
                    <summary>{f.q}</summary>
                    <p>{f.r}</p>
                  </details>
                ))}
              </div>
            </>
          )}
        </div>

        <aside class="art-side">
          <div class="art-side-inner">
            <nav class="art-toc" id="art-toc" aria-label="Sommaire">
              <p class="art-toc-h">Sommaire</p>
              <ol id="art-toc-list"></ol>
            </nav>

            {related.length > 0 && (
              <div class="art-related">
                <p class="art-related-h">À lire aussi</p>
                <ul>
                  {related.map((r) => (
                    <li>
                      <a href={`/${r.slug}/`}>
                        <img src={r.image} alt="" width="72" height="54" loading="lazy" />
                        <span>{r.title}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </aside>
      </div>
    </div>

    <section class="art-cta">
      <div class="wrap cta-inner">
        <h2>{ctaTitle}</h2>
        <p>{ctaText}</p>
        <a href={RDV} class="btn btn--primary">Réserver un appel</a>
      </div>
    </section>
  </article>

  {breadcrumbLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />}
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
</BaseLayout>

<script is:inline>
  (function () {
    var body = document.querySelector('.art-body');
    var list = document.getElementById('art-toc-list');
    var box = document.getElementById('art-toc');
    if (!body || !list || !box) return;
    var hs = body.querySelectorAll('h2');
    if (hs.length < 2) { box.remove(); return; }
    var slug = function (s) {
      return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '')
        .replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
    };
    hs.forEach(function (h, i) {
      var id = h.id || slug(h.textContent) || ('section-' + i);
      h.id = id;
      var li = document.createElement('li');
      var a = document.createElement('a');
      a.href = '#' + id;
      a.textContent = h.textContent;
      li.appendChild(a);
      list.appendChild(li);
    });
  })();
</script>

<script is:inline define:vars={{ MAILLAGE, curSlug }}>
  (function () {
    var body = document.querySelector('.art-body');
    if (!body) return;
    var esc = function (s) { return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); };
    var linked = {};
    body.querySelectorAll('a[href^="/"]').forEach(function (a) {
      var slug = a.getAttribute('href').replace(/^\/|\/$/g, '');
      if (slug) linked[slug] = true;
    });
    // Nombre de liens de maillage déjà présents (hors CTA / accueil / guides / rdv).
    var NON_MESH = { '/': 1, '/guides/': 1, '/formation/': 1, '/rendez-vous/': 1, '/rendez-vous': 1 };
    var existing = 0;
    body.querySelectorAll('a[href^="/"]').forEach(function (a) {
      if (!NON_MESH[a.getAttribute('href')]) existing++;
    });
    var paras = Array.prototype.slice.call(body.querySelectorAll(':scope > p')).slice(1);
    function wrapInParagraph(p, needle, href) {
      var re = new RegExp(esc(needle), 'i');
      var walker = document.createTreeWalker(p, NodeFilter.SHOW_TEXT, null);
      var nodes = [], n;
      while ((n = walker.nextNode())) { if (!n.parentElement.closest('a')) nodes.push(n); }
      for (var k = 0; k < nodes.length; k++) {
        var node = nodes[k], m = node.nodeValue.match(re);
        if (!m) continue;
        var i = m.index, before = node.nodeValue.slice(0, i);
        var match = node.nodeValue.slice(i, i + m[0].length);
        var after = node.nodeValue.slice(i + m[0].length);
        var a = document.createElement('a');
        a.href = href; a.textContent = match; a.setAttribute('data-mesh', '1');
        var frag = document.createDocumentFragment();
        if (before) frag.appendChild(document.createTextNode(before));
        frag.appendChild(a);
        if (after) frag.appendChild(document.createTextNode(after));
        node.parentNode.replaceChild(frag, node);
        return true;
      }
      return false;
    }
    // Cap : viser 5 liens de maillage MAX au total (naturel), donc on complète
    // seulement l'écart entre l'existant et 5, sans jamais dépasser 3 ajouts auto.
    var added = 0, MAX = Math.max(0, Math.min(3, 5 - existing));
    for (var x = 0; x < MAILLAGE.length && added < MAX; x++) {
      var item = MAILLAGE[x];
      if (item.slug === curSlug || linked[item.slug]) continue;
      var href = '/' + item.slug + '/';
      for (var j = 0; j < paras.length; j++) {
        if (wrapInParagraph(paras[j], item.needle, href)) { linked[item.slug] = true; added++; break; }
      }
    }
  })();
</script>

<script is:inline define:vars={{ MODULE1_URL }}>
  /* Insère un bloc CTA "module 1 offert" au milieu de l'article (pas au début). */
  (function () {
    var body = document.querySelector('.art-body');
    if (!body) return;
    var hs = Array.prototype.slice.call(body.querySelectorAll(':scope > h2')).filter(function (h) { return h.id !== 'faq'; });
    if (hs.length < 3) return;
    var target = hs[Math.floor(hs.length / 2)];
    if (!target) return;
    var box = document.createElement('div');
    box.className = 'art-midcta';
    var p = document.createElement('p');
    p.className = 'art-midcta-txt';
    p.textContent = 'Le premier module de la formation est offert. Passez de la théorie à la pratique, sans engagement.';
    var a = document.createElement('a');
    a.className = 'btn btn--primary';
    a.href = MODULE1_URL; a.target = '_blank'; a.rel = 'noopener';
    a.textContent = 'Accéder au module 1 offert →';
    box.appendChild(p); box.appendChild(a);
    target.parentNode.insertBefore(box, target);
  })();
</script>

<style is:global>
  .art .art-container { width: 100%; max-width: 1140px; margin-inline: auto; padding-inline: clamp(1.2rem, 4vw, 2.75rem); }

  .art .art-breadcrumb { padding-top: 1.4rem; }
  .art .art-breadcrumb ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; font-size: 0.82rem; color: var(--ink-faint); }
  .art .art-breadcrumb a { color: var(--ink-soft); text-decoration: none; }
  .art .art-breadcrumb a:hover { color: var(--gold); text-decoration: underline; }
  .art .art-breadcrumb .bc-sep { color: var(--ink-faint); margin-left: 0.4rem; }
  .art .art-breadcrumb [aria-current="page"] { color: var(--ink-faint); }

  /* Hero split : texte + auteur à gauche, image à droite */
  .art .art-hero2 { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(1.6rem, 4vw, 3.2rem); align-items: start; padding-top: clamp(1.2rem, 2.5vw, 2rem); padding-bottom: clamp(1.8rem, 4vw, 3rem); }
  .art .art-hero2-text { min-width: 0; }
  .art .art-hero2-text h1 { font-size: clamp(2.1rem, 4.2vw, 3.3rem); line-height: 1.06; margin: 0.9rem 0 0; text-wrap: balance; }
  .art .art-rule { border: 0; border-top: 1px solid var(--line); margin: 1.5rem 0 1.2rem; }
  .art .art-byline { display: flex; align-items: center; gap: 0.8rem; }
  .art .art-ava { flex: none; width: 46px; height: 46px; border-radius: 50%; background: var(--green); color: var(--paper); font-family: var(--font-display); font-weight: 600; display: grid; place-items: center; font-size: 1.2rem; }
  .art .art-byline-txt { font-size: 0.95rem; color: var(--ink); line-height: 1.35; }
  .art .art-byline-meta { display: block; color: var(--ink-faint); font-size: 0.82rem; margin-top: 0.15rem; }
  .art .art-hero2-fig { margin: 0; border-radius: 14px; overflow: hidden; border: 1px solid var(--line); }
  .art .art-hero2-fig img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; }

  .art .art-midcta { margin: 2.6rem 0; padding: clamp(1.5rem, 3vw, 2rem); background: var(--green); color: var(--paper); border-radius: 12px; text-align: center; }
  .art .art-body .art-midcta-txt { font-family: var(--font-display); font-size: clamp(1.1rem, 1.8vw, 1.3rem); line-height: 1.35; margin: 0 auto 1.2rem; max-width: 42ch; color: var(--paper); }
  .art .art-midcta .btn { background: var(--paper); color: var(--ink); border-color: var(--paper); }
  .art .art-midcta .btn:hover { background: var(--gold); border-color: var(--gold); color: var(--ink); }

  .art .art-layout { display: grid; grid-template-columns: minmax(0, 1fr) 290px; gap: clamp(2rem, 4vw, 3.5rem); align-items: start; padding-top: clamp(1.4rem, 3vw, 2.2rem); padding-bottom: clamp(3rem, 7vw, 5rem); border-top: 1px solid var(--line); }
  .art .art-body { max-width: 760px; min-width: 0; }

  .art .art-lead { font-size: clamp(1.02rem, 1.5vw, 1.18rem); line-height: 1.55; color: var(--ink-soft); margin-top: 1.3rem; max-width: 48ch; }

  .art .art-body h2 { font-size: clamp(1.5rem, 3vw, 2rem); margin: 2.4rem 0 1rem; scroll-margin-top: 90px; }
  .art .art-body h3 { font-size: clamp(1.2rem, 2.2vw, 1.4rem); margin: 1.6rem 0 0.7rem; }
  .art .art-body p { margin-bottom: 1.1rem; color: var(--ink); }
  .art .art-body ul, .art .art-body ol { margin: 0 0 1.3rem 1.2rem; display: grid; gap: 0.55rem; }
  .art .art-body li { padding-left: 0.25rem; }
  .art .art-body a { color: var(--green-bright); text-decoration: underline; text-underline-offset: 2px; text-decoration-thickness: 1px; }
  .art .art-body a:hover { color: var(--gold); }
  .art .note { font-size: 0.9rem; color: var(--ink-faint); font-style: italic; }

  .art .encadre { background: var(--paper-2); border: 1px solid var(--line); border-left: 3px solid var(--gold); border-radius: 8px; padding: 1.4rem 1.6rem; margin: 0 0 2rem; }
  .art .encadre-h { font-family: var(--font-display); font-size: 1.15rem; margin-bottom: 0.7rem; }
  .art .encadre ul { margin-bottom: 0; }

  .art .retenir { background: color-mix(in srgb, var(--green) 7%, var(--paper)); border: 1px solid color-mix(in srgb, var(--green) 25%, transparent); border-left: 3px solid var(--green); border-radius: 8px; padding: 1.4rem 1.6rem; margin: 2.6rem 0 2rem; }
  .art .retenir-h { font-family: var(--font-display); font-size: 1.15rem; margin-bottom: 0.7rem; color: var(--green); }
  .art .retenir ul { margin: 0 0 0 1.1rem; display: grid; gap: 0.55rem; }
  .art .retenir li { color: var(--ink); }

  .art table { width: 100%; border-collapse: collapse; margin: 0.5rem 0 1.4rem; font-size: 0.98rem; }
  .art th, .art td { text-align: left; padding: 0.7rem 0.9rem; border-bottom: 1px solid var(--line); }
  .art th { font-family: var(--font-body); font-weight: 600; background: var(--paper-2); }

  .art .faq { display: grid; gap: 0.7rem; }
  .art .faq-item { border: 1px solid var(--line); border-radius: 8px; background: var(--paper); padding: 0.2rem 1.1rem; }
  .art .faq-item summary { cursor: pointer; font-family: var(--font-display); font-size: 1.1rem; padding: 0.9rem 0; list-style: none; }
  .art .faq-item summary::-webkit-details-marker { display: none; }
  .art .faq-item summary::after { content: '+'; float: right; color: var(--gold); font-size: 1.3rem; line-height: 1; }
  .art .faq-item[open] summary::after { content: '–'; }
  .art .faq-item p { padding-bottom: 1rem; margin: 0; color: var(--ink-soft); }

  .art .art-side-inner { position: sticky; top: 90px; display: grid; gap: 1.6rem; }
  .art .art-toc-h { font-family: var(--font-display); font-size: 1.05rem; margin-bottom: 0.7rem; }
  .art .art-toc ol { margin: 0; padding: 0; list-style: none; counter-reset: toc; display: grid; gap: 0.5rem; }
  .art .art-toc li { counter-increment: toc; font-size: 0.9rem; line-height: 1.35; padding-left: 1.6rem; position: relative; }
  .art .art-toc li::before { content: counter(toc); position: absolute; left: 0; top: 0; color: var(--gold); font-weight: 600; font-size: 0.8rem; }
  .art .art-toc a { color: var(--ink-soft); text-decoration: none; }
  .art .art-toc a:hover { color: var(--gold); }

  .art .art-related { padding-top: 1.3rem; border-top: 1px solid var(--line); }
  .art .art-related-h { font-family: var(--font-display); font-size: 1.05rem; margin-bottom: 0.9rem; }
  .art .art-related ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.9rem; }
  .art .art-related a { display: flex; gap: 0.7rem; align-items: center; text-decoration: none; color: var(--ink); }
  .art .art-related img { flex: none; width: 64px; height: 48px; object-fit: cover; border-radius: 6px; border: 1px solid var(--line); }
  .art .art-related span { font-size: 0.86rem; line-height: 1.3; }
  .art .art-related a:hover span { color: var(--gold); }

  .art .art-cta { padding-top: clamp(2rem, 5vw, 3.5rem); padding-bottom: clamp(3rem, 6vw, 4.5rem); text-align: center; background: var(--paper-2); border-top: 1px solid var(--line); }
  .art .cta-inner h2 { font-size: clamp(1.9rem, 4.2vw, 2.9rem); max-width: 20ch; margin-inline: auto; }
  .art .cta-inner p { color: var(--ink-soft); margin: 1rem auto 2rem; font-size: 1.06rem; max-width: 48ch; }

  @media (max-width: 900px) {
    .art .art-hero2 { grid-template-columns: 1fr; gap: 1.6rem; padding-bottom: 1.5rem; }
    .art .art-hero2-fig { order: 2; }
    .art .art-layout { grid-template-columns: 1fr; gap: 2.2rem; }
    .art .art-side-inner { position: static; }
    .art .art-body { max-width: none; }
  }
</style>
