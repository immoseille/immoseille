---
import BaseLayout from './BaseLayout.astro';

const { title, description, h1, updated = '9 août 2026' } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="legal">
    <div class="wrap legal-wrap">
      <p class="eyebrow">Informations légales</p>
      <h1>{h1}</h1>
      <p class="legal-updated">Dernière mise à jour : {updated}</p>
      <div class="legal-body">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style is:global>
  .legal .legal-wrap { max-width: 760px; }
  .legal { padding-top: clamp(2.5rem, 6vw, 4.5rem); padding-bottom: clamp(3.5rem, 8vw, 6rem); }
  .legal h1 { font-size: clamp(2.2rem, 5vw, 3.2rem); margin: 1rem 0 0.5rem; }
  .legal .legal-updated { color: var(--ink-faint); font-size: 0.85rem; margin-bottom: 2.2rem; }
  .legal .legal-body h2 { font-size: clamp(1.3rem, 2.6vw, 1.7rem); margin: 2.2rem 0 0.7rem; }
  .legal .legal-body p { margin-bottom: 1rem; color: var(--ink); }
  .legal .legal-body ul { margin: 0 0 1.2rem 1.2rem; display: grid; gap: 0.45rem; }
  .legal .legal-body a { color: var(--green-bright); text-decoration: underline; text-underline-offset: 2px; }
  .legal .legal-body a:hover { color: var(--gold); }
  /* Placeholder "à compléter" : surligné pour repérage facile */
  .legal .tbf { background: color-mix(in srgb, var(--gold) 16%, transparent); border-bottom: 1px dashed var(--gold); padding: 0 0.25rem; border-radius: 3px; font-style: italic; }
</style>
