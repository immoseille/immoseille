---
const year = new Date().getFullYear();
const RDV = 'https://app.iclosed.io/e/emiredschool/immoseille';
const cols = [
  {
    title: 'Le métier',
    links: [
      { href: '/devenir-marchand-de-biens', label: 'Devenir marchand de biens' },
      { href: '/marchand-de-biens-definition', label: 'Marchand de biens : c’est quoi ?' },
      { href: '/marchand-de-biens-salaire', label: 'Salaire d’un marchand de biens' },
      { href: '/avantages-inconvenients-marchand-de-biens', label: 'Avantages et inconvénients' },
    ],
  },
  {
    title: 'Statut & finance',
    links: [
      { href: '/statut-juridique-marchand-de-biens', label: 'Statut juridique' },
      { href: '/tva-marchand-de-biens', label: 'Fiscalité et TVA' },
      { href: '/frais-de-notaire-marchand-de-biens', label: 'Frais de notaire' },
      { href: '/financement-marchand-de-biens', label: 'Financement' },
      { href: '/marchand-de-biens-sans-apport', label: 'Se lancer sans apport' },
    ],
  },
  {
    title: 'Opérations',
    links: [
      { href: '/monter-une-operation-marchand-de-biens', label: 'Monter une opération' },
      { href: '/achat-revente-immobilier', label: 'Achat-revente immobilier' },
      { href: '/diviser-un-terrain', label: 'Diviser un terrain' },
      { href: '/simulateur-rentabilite-marchand-de-biens', label: 'Simulateur de rentabilité' },
    ],
  },
  {
    title: 'Imm’oseille',
    links: [
      { href: '/formation', label: 'La formation' },
      { href: '/guides', label: 'Guides' },
      { href: '/a-propos', label: 'À propos' },
      { href: '/mentions-legales', label: 'Mentions légales' },
      { href: '/politique-confidentialite', label: 'Confidentialité' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <img src="/logo-full.png" alt="Imm'oseille, formation marchand de biens" class="footer-logo" width="240" />
      <a href={RDV} class="btn btn--ghost">Réserver un appel</a>
      <div class="footer-social">
        <a href="https://www.instagram.com/immoseille/" class="footer-ig" target="_blank" rel="noopener" aria-label="Imm'oseille sur Instagram">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
          <span>@immoseille</span>
        </a>
      </div>
    </div>

    <nav class="footer-cols" aria-label="Pied de page">
      {cols.map((c) => (
        <div class="footer-col">
          <h4>{c.title}</h4>
          <ul>
            {c.links.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </div>

  <div class="wrap footer-bottom">
    <span>&copy; {year} Imm'oseille. Tous droits réservés.</span>
    <span class="footer-note">Le métier de marchand de biens comporte des risques et ne procure aucun revenu fixe.</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(4rem, 9vw, 7rem);
    border-top: 1px solid var(--line);
    background: var(--paper-2);
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1.3fr 2fr;
    gap: clamp(2rem, 5vw, 4rem);
    padding-top: clamp(3rem, 6vw, 4.5rem);
    padding-bottom: 3rem;
  }
  .footer-logo {
    height: auto;
    max-width: 240px;
    margin-bottom: 1.6rem;
    display: block;
  }
  .footer-cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  .footer-col h4 {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 1rem;
  }
  .footer-col ul { list-style: none; }
  .footer-col li { margin-bottom: 0.6rem; }
  .footer-col a {
    color: var(--ink-soft);
    font-size: 0.96rem;
    transition: color 0.15s ease;
  }
  .footer-col a:hover { color: var(--gold); }

  .footer-social { margin-top: 1.4rem; }
  .footer-ig {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink-soft);
    font-size: 0.92rem;
    font-weight: 600;
    transition: color 0.15s ease;
  }
  .footer-ig svg { flex: none; }
  .footer-ig:hover { color: var(--gold); }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.4rem;
    padding-bottom: 1.8rem;
    border-top: 1px solid var(--line-soft);
    font-size: 0.82rem;
    color: var(--ink-faint);
  }
  .footer-note { max-width: 46ch; }

  @media (max-width: 860px) {
    .footer-inner { grid-template-columns: 1fr; }
    .footer-cols { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .footer-cols { grid-template-columns: 1fr; gap: 1.8rem; }
  }
</style>
