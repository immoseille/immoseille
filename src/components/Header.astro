---
// Lien de prise de rendez-vous (iClosed) — fonctionnel dès la preprod
const RDV = 'https://app.iclosed.io/e/immoseille/appel-strategique';

// Silos de contenu (préprod : certaines pages restent à produire)
const metier = [
  { href: '/devenir-marchand-de-biens', label: 'Devenir marchand de biens' },
  { href: '/marchand-de-biens-definition', label: 'Marchand de biens : c’est quoi ?' },
  { href: '/marchand-de-biens-salaire', label: 'Salaire d’un marchand de biens' },
  { href: '/avantages-inconvenients-marchand-de-biens', label: 'Avantages et inconvénients' },
];

const statut = [
  { href: '/statut-juridique-marchand-de-biens', label: 'Statut juridique (SAS, SASU, SCI)' },
  { href: '/tva-marchand-de-biens', label: 'Fiscalité et TVA' },
  { href: '/frais-de-notaire-marchand-de-biens', label: 'Frais de notaire' },
  { href: '/plus-value-marchand-de-biens', label: 'Plus-value' },
];

const finance = [
  { href: '/financement-marchand-de-biens', label: 'Financer une opération' },
  { href: '/banque-marchand-de-biens', label: 'Banques spécialisées' },
  { href: '/marchand-de-biens-sans-apport', label: 'Se lancer sans apport' },
  { href: '/crowdfunding-immobilier', label: 'Crowdfunding immobilier' },
  { href: '/portage-immobilier', label: 'Portage immobilier' },
];

const operations = [
  { href: '/monter-une-operation-marchand-de-biens', label: 'Monter une opération' },
  { href: '/achat-revente-immobilier', label: 'Achat-revente immobilier' },
  { href: '/diviser-un-terrain', label: 'Diviser un terrain' },
  { href: '/simulateur-rentabilite-marchand-de-biens', label: 'Simulateur de rentabilité' },
  { href: '/calcul-rentabilite-marchand-de-biens', label: 'Calcul de rentabilité' },
];
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand" aria-label="Imm'oseille, accueil">
      <img src="/logo-mark.png" alt="" width="40" height="40" class="brand-icon" />
      <span class="brand-mark">Imm<span class="apos">'</span>oseille</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden />
    <label for="nav-toggle" class="burger" aria-label="Ouvrir le menu">
      <span></span><span></span><span></span>
    </label>

    <nav class="nav" aria-label="Navigation principale">
      <a href="/formation" class="nav-link">La formation</a>

      <div class="nav-group">
        <span class="nav-link nav-trigger" tabindex="0" role="button" aria-haspopup="true">
          Le métier
          <svg class="caret" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
        </span>
        <div class="nav-panel">
          {metier.map((l) => <a href={l.href}>{l.label}</a>)}
        </div>
      </div>

      <div class="nav-group nav-group--wide">
        <span class="nav-link nav-trigger" tabindex="0" role="button" aria-haspopup="true">
          Statut &amp; finance
          <svg class="caret" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
        </span>
        <div class="nav-panel nav-panel--cols">
          <div class="panel-col">
            <span class="panel-head">Statut &amp; fiscalité</span>
            {statut.map((l) => <a href={l.href}>{l.label}</a>)}
          </div>
          <div class="panel-col">
            <span class="panel-head">Financement</span>
            {finance.map((l) => <a href={l.href}>{l.label}</a>)}
          </div>
        </div>
      </div>

      <div class="nav-group">
        <span class="nav-link nav-trigger" tabindex="0" role="button" aria-haspopup="true">
          Opérations
          <svg class="caret" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
        </span>
        <div class="nav-panel">
          {operations.map((l) => <a href={l.href}>{l.label}</a>)}
        </div>
      </div>

      <a href="/guides" class="nav-link">Guides</a>
      <a href="/a-propos" class="nav-link">À propos</a>
      <a href={RDV} class="btn btn--primary nav-cta">Réserver un appel</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  .brand { display: inline-flex; align-items: center; gap: 0.6rem; }
  .brand-icon { width: 38px; height: 38px; object-fit: contain; display: block; }
  .brand-mark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .brand-mark .apos { color: var(--gold); }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 1.8vw, 1.6rem);
  }

  .nav-link {
    font-weight: 500;
    font-size: 0.96rem;
    color: var(--ink-soft);
    position: relative;
    padding: 0.25rem 0;
    transition: color 0.15s ease;
    white-space: nowrap;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 0;
    height: 1.5px;
    background: var(--gold);
    transition: width 0.22s ease;
  }
  a.nav-link:hover { color: var(--ink); }
  a.nav-link:hover::after { width: 100%; }

  /* Groupes déroulants */
  .nav-group { position: relative; }
  .nav-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    cursor: default;
    user-select: none;
  }
  .nav-group:hover .nav-trigger,
  .nav-group:focus-within .nav-trigger { color: var(--ink); }
  .caret {
    width: 13px; height: 13px; flex: none;
    fill: none; stroke: currentColor; stroke-width: 2.2;
    stroke-linecap: round; stroke-linejoin: round;
    transition: transform 0.2s ease;
    opacity: 0.7;
  }
  .nav-group:hover .caret,
  .nav-group:focus-within .caret { transform: rotate(180deg); }

  .nav-panel {
    position: absolute;
    top: calc(100% + 12px);
    left: -0.4rem;
    min-width: 250px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: 0 22px 48px -26px rgba(23, 21, 15, 0.55);
    padding: 0.55rem;
    display: grid;
    gap: 0.1rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
    z-index: 120;
  }
  /* pont invisible pour ne pas perdre le survol dans le gap */
  .nav-panel::before {
    content: '';
    position: absolute;
    top: -12px; left: 0; right: 0;
    height: 12px;
  }
  .nav-group:hover .nav-panel,
  .nav-group:focus-within .nav-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .nav-panel a {
    display: block;
    padding: 0.5rem 0.7rem;
    border-radius: 7px;
    font-size: 0.94rem;
    color: var(--ink-soft);
    white-space: nowrap;
    transition: background-color 0.14s ease, color 0.14s ease;
  }
  .nav-panel a:hover { background: var(--paper-2); color: var(--ink); }

  .nav-panel--cols {
    grid-template-columns: 1fr 1fr;
    gap: 0.2rem 1.4rem;
    min-width: 470px;
  }
  .panel-head {
    display: block;
    font-size: 0.7rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 600;
    padding: 0.5rem 0.7rem 0.25rem;
  }

  .nav-cta { padding: 0.62rem 1.1rem; font-size: 0.9rem; }

  /* Burger (mobile) */
  .burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    padding: 0.4rem;
  }
  .burger span {
    width: 26px; height: 2px;
    background: var(--ink);
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  @media (max-width: 980px) {
    .burger { display: flex; }
    .nav {
      position: fixed;
      inset: 72px 0 auto 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.15rem;
      background: var(--paper);
      border-bottom: 1px solid var(--line);
      padding: 1.1rem clamp(1.2rem, 4vw, 2.75rem) 1.75rem;
      max-height: calc(100dvh - 72px);
      overflow-y: auto;
      transform: translateY(-120%);
      transition: transform 0.3s ease;
      box-shadow: 0 18px 40px -22px rgba(23, 21, 15, 0.4);
    }
    .nav > .nav-link { font-size: 1.1rem; padding: 0.55rem 0; }

    /* Les groupes s'affichent dépliés (accordéon visuel) en mobile */
    .nav-group { position: static; width: 100%; }
    .nav-trigger {
      font-size: 0.78rem;
      letter-spacing: 0.11em;
      text-transform: uppercase;
      color: var(--ink-faint);
      font-weight: 600;
      padding: 0.9rem 0 0.35rem;
      cursor: default;
    }
    .caret { display: none; }
    .nav-panel,
    .nav-panel--cols {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      box-shadow: none;
      border: 0;
      background: transparent;
      padding: 0 0 0 0.9rem;
      min-width: 0;
      display: block;
    }
    .nav-panel::before { display: none; }
    .nav-panel a { white-space: normal; font-size: 1.02rem; padding: 0.4rem 0; }
    .panel-head { padding: 0.7rem 0 0.15rem; }

    .nav-cta {
      margin-top: 1rem;
      width: 100%;
      justify-content: center;
      padding: 0.85rem 1.1rem;
      font-size: 0.98rem;
    }
    .nav-toggle:checked ~ .nav { transform: translateY(0); }
    .nav-toggle:checked ~ .burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav-toggle:checked ~ .burger span:nth-child(2) { opacity: 0; }
    .nav-toggle:checked ~ .burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  }
</style>
