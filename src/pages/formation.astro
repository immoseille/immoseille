---
import BaseLayout from '../layouts/BaseLayout.astro';

// Lien de prise de rendez-vous (iClosed)
const CALENDLY = 'https://app.iclosed.io/e/immoseille/appel-strategique';
// Module 1 offert (hébergé sur base44)
const MODULE1 = 'https://immoseille-module1.base44.app/';

const format = [
  { t: 'Des cours en vidéo', d: "Le programme complet en vidéo, hébergé sur Skool, accessible à la demande et à votre rythme." },
  { t: 'Un accompagnement', d: "Vos opérations sont analysées avec vous. Vous avancez avec un cadre, pas seul face à un écran." },
  { t: 'Une communauté', d: "Un espace d’entraide entre porteurs de projet et marchands de biens, pour ne rien lâcher." },
  { t: 'Des cas réels', d: "Chaque notion est illustrée par de vraies opérations décortiquées, chiffres à l’appui." },
];

const modules = [
  { n: '01', t: 'Introduction', free: true },
  { n: '02', t: 'Organisation' },
  { n: '03', t: 'Les opérations du marchand de biens' },
  { n: '04', t: 'Secteur' },
  { n: '05', t: 'Approvisionnement' },
  { n: '06', t: 'Visite' },
  { n: '07', t: 'Modélisation' },
  { n: '08', t: 'Négociation' },
  { n: '09', t: 'Responsabilité du marchand' },
  { n: '10', t: 'Éviction' },
  { n: '11', t: 'Création de société' },
  { n: '12', t: 'Assurance' },
  { n: '13', t: 'Chronologie et suivi d’opération' },
  { n: '14', t: 'Financement' },
  { n: '15', t: 'Urbanisme' },
  { n: '16', t: 'Travaux' },
  { n: '17', t: 'Bonus' },
];

const chapitres = [
  'Bienvenue — visite de la formation',
  'Introduction à la formation',
  'Les bases du métier de marchand de biens',
  'La mentalité de l’entrepreneur',
  'Session d’accompagnement mensuelle',
  '🎁 Bonus — financer ses opérations sans apport',
  'Et maintenant ?',
];

const notions = [
  { t: 'Les bases du métier', d: "Ce qu’est réellement un marchand de biens, et ce que ce n’est pas." },
  { t: 'La mentalité de l’entrepreneur', d: "L’état d’esprit et les réflexes qui font la différence sur le terrain." },
  { t: 'Financer sans apport', d: "Le bonus du module : les leviers pour se lancer même sans capital de départ." },
];

const parcours = [
  { n: '1', t: 'Appel découverte', d: "On échange 20 minutes sur votre situation et vos objectifs, sans engagement." },
  { n: '2', t: 'Accès à la formation', d: "Vous démarrez le programme en vidéo sur Skool, à votre rythme." },
  { n: '3', t: 'Accompagnement', d: "On avance ensemble sur vos premières opérations, avec un cadre concret." },
  { n: '4', t: 'Passage à l’action', d: "Vous montez votre opération et vous professionnalisez, étape par étape." },
];
---

<BaseLayout
  title="Formation marchand de biens | Imm'oseille"
  description="La formation Imm'oseille pour devenir marchand de biens : sourcing, montage d'opération, financement, travaux, revente et fiscalité. Premier module offert."
>
  <!-- HERO -->
  <section class="fhero">
    <div class="wrap">
      <p class="eyebrow">La formation</p>
      <h1>Apprenez le métier de marchand de biens, avec méthode</h1>
      <p class="fhero-sub">
        Un programme complet, de la recherche d’un bien à la revente, pensé pour
        vous rendre autonome et opérationnel. De la pédagogie de terrain, un
        accompagnement, zéro promesse en l’air.
      </p>
      <div class="fhero-cta">
        <a href={CALENDLY} class="btn btn--primary">Réserver un appel &rarr;</a>
        <a href="#module-offert" class="btn btn--ghost">Le 1er module offert</a>
      </div>
    </div>
  </section>

  <!-- FORMAT -->
  <section class="section format">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Le format</p>
        <h2>Comment se déroule la formation</h2>
        <p class="lede">Des vidéos à la demande, un accompagnement, une communauté. Le tout ancré dans des cas réels.</p>
      </div>
      <div class="format-grid">
        {format.map((f) => (
          <article class="format-card">
            <h3>{f.t}</h3>
            <p>{f.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- PROGRAMME -->
  <section class="section prog">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Le programme</p>
        <h2>Le programme complet, en 17 modules</h2>
        <p class="lede">De l’introduction au montage d’opérations complexes : tout le métier, module par module. Le premier module est offert.</p>
      </div>
      <div class="prog-grid">
        {modules.map((m) => (
          <article class={`prog-card${m.free ? ' prog-card--free' : ''}`}>
            <div class="prog-top">
              <span class="prog-num">{`Module ${Number(m.n)}`}</span>
              {m.free && <span class="prog-badge">Offert</span>}
            </div>
            <h3>{m.t}</h3>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- PREMIER MODULE OFFERT -->
  <section class="offert" id="module-offert">
    <div class="wrap offert-inner">
      <div class="offert-head">
        <p class="eyebrow eyebrow--light">Le premier module, offert</p>
        <h2>Commencez par le module 1, gratuitement</h2>
        <p>
          Avant de vous engager, on vous offre le premier module : les bases du
          métier, la mentalité de l’entrepreneur et un bonus pour financer ses
          opérations sans apport. De quoi vous faire une vraie idée du contenu et
          de la pédagogie.
        </p>
      </div>

      <div class="offert-body">
        <div class="offert-col">
          <h3 class="offert-subtitle">Au programme du module 1</h3>
          <ol class="offert-chap">
            {chapitres.map((c, i) => (
              <li><span class="offert-n">{`1.${i + 1}`}</span>{c}</li>
            ))}
          </ol>
        </div>
        <div class="offert-col">
          <h3 class="offert-subtitle">Ce que vous retenez dès ce module</h3>
          <div class="offert-notions">
            {notions.map((n) => (
              <article class="offert-notion">
                <h4>{n.t}</h4>
                <p>{n.d}</p>
              </article>
            ))}
          </div>
        </div>
      </div>

      <div class="offert-actions">
        <a href={MODULE1} class="btn btn--gold" target="_blank" rel="noopener">Accéder au module 1 offert &rarr;</a>
        <a href={CALENDLY} class="offert-link">ou réserver un appel</a>
      </div>
    </div>
  </section>

  <!-- PARCOURS -->
  <section class="section parcours">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Le parcours</p>
        <h2>Comment ça se passe, concrètement</h2>
      </div>
      <div class="parcours-grid">
        {parcours.map((p) => (
          <article class="parcours-step">
            <span class="parcours-num">{p.n}</span>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-band">
    <div class="wrap cta-inner">
      <h2>Prêt à vous lancer sérieusement ?</h2>
      <p>On échange 20 minutes sur votre projet, sans engagement.</p>
      <a href={CALENDLY} class="btn btn--primary">Réserver mon appel</a>
    </div>
  </section>
</BaseLayout>

<style>
  .section { padding-top: clamp(3.5rem, 8vw, 6rem); padding-bottom: clamp(3.5rem, 8vw, 6rem); }
  .section-head { max-width: 46ch; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .section-head h2 { font-size: clamp(1.9rem, 4vw, 2.9rem); margin: 0.6rem 0 0.8rem; }
  .lede { color: var(--ink-soft); font-size: 1.06rem; }
  .check { width: 19px; height: 19px; flex: none; fill: none; stroke: var(--green-bright); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }

  /* HERO */
  .fhero { padding-top: clamp(3rem, 7vw, 5rem); padding-bottom: clamp(2.5rem, 5vw, 4rem); }
  .fhero h1 { font-size: clamp(2.4rem, 5.6vw, 4rem); margin: 1rem 0 1.3rem; max-width: 18ch; }
  .fhero-sub { color: var(--ink-soft); font-size: clamp(1.02rem, 1.5vw, 1.18rem); max-width: 52ch; margin-bottom: 2rem; }
  .fhero-cta { display: flex; flex-wrap: wrap; gap: 0.85rem; }

  /* FORMAT */
  .format { background: var(--paper-2); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .format-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.2rem; }
  .format-card { background: var(--paper); border: 1px solid var(--line); border-radius: 10px; padding: 1.5rem; }
  .format-card h3 { font-size: 1.2rem; margin-bottom: 0.5rem; }
  .format-card p { color: var(--ink-soft); font-size: 0.96rem; }

  /* PROGRAMME */
  .prog-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.9rem; }
  .prog-card { border: 1px solid var(--line); border-radius: 10px; padding: 1.1rem 1.25rem; background: var(--paper); }
  .prog-top { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .prog-card--free { border-color: color-mix(in srgb, var(--gold) 60%, var(--line)); box-shadow: 0 0 0 1px color-mix(in srgb, var(--gold) 35%, transparent); }
  .prog-num { font-family: var(--font-body); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--gold); font-weight: 600; }
  .prog-badge { font-size: 0.6rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink); background: var(--gold); border-radius: 100px; padding: 0.2rem 0.55rem; font-weight: 600; }
  .prog-card h3 { font-size: 1.08rem; margin: 0.5rem 0 0; line-height: 1.25; }

  /* PREMIER MODULE OFFERT */
  .offert { background: var(--green); color: var(--paper); }
  .offert-inner { padding-top: clamp(3rem, 6vw, 5rem); padding-bottom: clamp(3rem, 6vw, 5rem); }
  .offert-head { max-width: 56ch; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .offert-head h2 { color: var(--paper); font-size: clamp(1.9rem, 4vw, 2.8rem); margin: 0.5rem 0 0.8rem; }
  .offert-head p { color: color-mix(in srgb, var(--paper) 82%, transparent); font-size: 1.06rem; }
  .eyebrow--light { color: var(--gold); }

  .offert-body { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4rem); }
  .offert-subtitle { color: var(--gold); font-family: var(--font-body); font-weight: 600; font-size: 0.82rem; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 1.2rem; }
  .offert-chap { list-style: none; display: grid; gap: 0.7rem; }
  .offert-chap li { display: flex; gap: 0.9rem; align-items: baseline; padding-bottom: 0.7rem; border-bottom: 1px solid rgba(243,239,228,0.16); font-size: 1.02rem; }
  .offert-n { font-family: var(--font-display); color: var(--gold); font-weight: 600; flex: none; }

  .offert-notions { display: grid; gap: 0.9rem; }
  .offert-notion { border: 1px solid rgba(243,239,228,0.18); border-radius: 10px; padding: 1.1rem 1.2rem; }
  .offert-notion h4 { color: var(--paper); font-family: var(--font-display); font-size: 1.1rem; font-weight: 560; margin-bottom: 0.3rem; }
  .offert-notion p { color: color-mix(in srgb, var(--paper) 74%, transparent); font-size: 0.94rem; }

  .btn--gold { background: var(--gold); border-color: var(--gold); color: var(--ink); }
  .btn--gold:hover { background: var(--paper); border-color: var(--paper); color: var(--ink); transform: translateY(-2px); }
  .offert-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.2rem; margin-top: clamp(2rem, 4vw, 3rem); }
  .offert-link { color: color-mix(in srgb, var(--paper) 80%, transparent); font-weight: 500; text-decoration: underline; text-underline-offset: 3px; font-size: 0.98rem; }
  .offert-link:hover { color: var(--gold); }

  /* PARCOURS */
  .parcours-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.2rem; }
  .parcours-step { padding: 1.6rem; border: 1px solid var(--line); border-radius: 10px; background: var(--paper); }
  .parcours-num { display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--green); color: var(--paper); font-family: var(--font-display); font-weight: 600; font-size: 1.1rem; margin-bottom: 0.8rem; }
  .parcours-step h3 { font-size: 1.2rem; margin-bottom: 0.4rem; }
  .parcours-step p { color: var(--ink-soft); font-size: 0.95rem; }

  /* CTA */
  .cta-band { padding-top: clamp(3.5rem, 8vw, 6rem); padding-bottom: clamp(1rem, 4vw, 2rem); text-align: center; }
  .cta-inner h2 { font-size: clamp(2rem, 4.5vw, 3.1rem); max-width: 20ch; margin-inline: auto; }
  .cta-inner p { color: var(--ink-soft); margin: 1rem auto 2rem; font-size: 1.08rem; }

  @media (max-width: 900px) {
    .format-grid, .parcours-grid { grid-template-columns: repeat(2, 1fr); }
    .offert-body { grid-template-columns: 1fr; gap: 2rem; }
  }
  @media (max-width: 560px) {
    .format-grid, .parcours-grid { grid-template-columns: 1fr; }
  }
</style>
