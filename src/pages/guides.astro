---
import BaseLayout from '../layouts/BaseLayout.astro';
import { articles } from '../data/articles.js';

// Page Guides = uniquement les articles/contenus HORS menu header (flag guide: true).
// Tri par date décroissante (plus récent en premier).
const MONTHS = { janvier: 1, février: 2, mars: 3, avril: 4, mai: 5, juin: 6, juillet: 7, août: 8, septembre: 9, octobre: 10, novembre: 11, décembre: 12 };
function dateKey(d) {
  if (!d) return 0;
  const m = d.trim().toLowerCase().match(/(\d{1,2})\s+([a-zûéô]+)\s+(\d{4})/);
  if (!m) return 0;
  return parseInt(m[3]) * 10000 + (MONTHS[m[2]] || 0) * 100 + parseInt(m[1]);
}
const guides = articles.filter((a) => a.guide).sort((a, b) => dateKey(b.date) - dateKey(a.date));
const PER_PAGE = 8;
// On rend TOUS les guides (crawlables) ; ceux au-delà de PER_PAGE sont masqués puis
// révélés au clic sur « Voir plus ».
const hasMore = guides.length > PER_PAGE;
---

<BaseLayout
  title="Guides marchand de biens | Imm'oseille"
  description="Nos guides et ressources sur le métier de marchand de biens : fiscalité, montage, financement et conseils de terrain."
>
  <div class="wrap">
    <nav class="gbc" aria-label="Fil d'Ariane">
      <ol>
        <li><a href="/">Accueil</a><span class="sep" aria-hidden="true">›</span></li>
        <li><span aria-current="page">Guides</span></li>
      </ol>
    </nav>
  </div>

  <header class="ghero">
    <h1>Guides</h1>
    <p class="ghero-sub">Nos ressources de terrain sur le métier de marchand de biens.</p>
  </header>

  <section class="section">
    <div class="wrap">
      <h2 class="gsec-title">Nos guides</h2>

      {guides.length === 0 ? (
        <p class="gempty">De nouveaux guides arrivent bientôt.</p>
      ) : (
        <div class="news-grid">
          {guides.map((g, i) => (
            <a class={`news-card${i >= PER_PAGE ? ' news-card--hidden' : ''}`} href={`/${g.slug}/`}>
              <div class="news-thumb">
                <img src={g.image} alt="" width="320" height="200" loading="lazy" />
              </div>
              {g.date && <p class="news-date">Mis à jour le {g.date}</p>}
              <h3>{g.title}</h3>
              {g.excerpt && <p class="news-excerpt">{g.excerpt}</p>}
            </a>
          ))}
        </div>
      )}

      {hasMore && (
        <div class="gmore">
          <button class="btn btn--ghost" id="guides-more" type="button">Voir plus</button>
        </div>
      )}
    </div>
  </section>

  <script is:inline>
    (function () {
      var btn = document.getElementById('guides-more');
      if (!btn) return;
      btn.addEventListener('click', function () {
        document.querySelectorAll('.news-card--hidden').forEach(function (c) {
          c.classList.remove('news-card--hidden');
        });
        btn.style.display = 'none';
      });
    })();
  </script>
</BaseLayout>

<style>
  .gbc { padding-top: 1.4rem; }
  .gbc ol { list-style: none; margin: 0; padding: 0; display: flex; gap: 0.4rem; align-items: center; font-size: 0.82rem; color: var(--ink-faint); }
  .gbc a { color: var(--ink-soft); text-decoration: underline; text-underline-offset: 2px; }
  .gbc a:hover { color: var(--gold); }
  .gbc .sep { margin-left: 0.4rem; color: var(--ink-faint); }

  .ghero { text-align: center; padding: clamp(2.5rem, 6vw, 4.5rem) 1.2rem clamp(1.5rem, 4vw, 3rem); }
  .ghero h1 { font-size: clamp(2.6rem, 6vw, 4.2rem); }
  .ghero-sub { color: var(--ink-soft); font-size: clamp(1.02rem, 1.6vw, 1.2rem); margin-top: 1rem; }

  .section { padding-bottom: clamp(3.5rem, 8vw, 6rem); }
  .gsec-title { font-size: clamp(1.5rem, 3vw, 2rem); margin-bottom: 1.8rem; }

  .news-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(1.4rem, 2.5vw, 2rem); }
  .news-card { display: flex; flex-direction: column; text-decoration: none; color: var(--ink); }
  .news-thumb { aspect-ratio: 16 / 10; border-radius: 12px; overflow: hidden; background: var(--paper-2); margin-bottom: 0.9rem; }
  .news-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.3s ease; }
  .news-card:hover .news-thumb img { transform: scale(1.04); }
  .news-date { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.04em; color: var(--gold); margin-bottom: 0.35rem; }
  .news-card h3 { font-size: 1.12rem; line-height: 1.25; margin-bottom: 0.5rem; }
  .news-card:hover h3 { color: var(--green-bright); }
  .news-excerpt { color: var(--ink-faint); font-size: 0.9rem; line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  .news-card--hidden { display: none; }

  .gempty { color: var(--ink-soft); }
  .gmore { text-align: center; margin-top: clamp(2.5rem, 5vw, 3.5rem); }

  @media (max-width: 900px) { .news-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .news-grid { grid-template-columns: 1fr; } }
</style>
